{
  "name": "dsh-vision-analysis",
  "version": "0.1.1-rc.2",
  "description": "Model-facing analyze_image tool for the DeepSeek Harness: multi-modal image understanding via any OpenAI- or Anthropic-compatible vision API, with 8 analysis modes, local path / http(s) URL / data URL input, and a Web UI hint that guides image-incapable models to the reliable local-path route.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.json && tsdown --env.DSH_BUILD_FACE client",
    "prepare": "tsc -p tsconfig.json && tsdown --env.DSH_BUILD_FACE client",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "node --test tests/smoke.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "image-analysis",
    "ocr",
    "multimodal"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || >=0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || >=0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-web-react": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.2"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-org>/dsh-vision-analysis.git"
  },
  "homepage": "https://github.com/<your-org>/dsh-vision-analysis#readme",
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-invariants": "0.1.1-rc.1",
      "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
      "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
      "@deepseek-ai/dsh-scope": "0.1.1-rc.1",
      "@deepseek-ai/dsh-session": "0.1.1-rc.1",
      "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.1",
      "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.1",
      "@deepseek-ai/dsh-user-approval": "0.1.1-rc.1",
      "@deepseek-ai/dsh-brand": "0.1.1-rc.1",
      "@deepseek-ai/dsh-timeout": "0.1.1-rc.1",
      "@deepseek-ai/dsh-attachment": "0.1.1-rc.1",
      "@deepseek-ai/dsh-commands": "0.1.1-rc.1",
      "@deepseek-ai/dsh-llm-retry": "0.1.1-rc.1",
      "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.1",
      "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.1",
      "@deepseek-ai/dsh-session-title": "0.1.1-rc.1",
      "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.1",
      "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.1",
      "@deepseek-ai/dsh-typert-loader": "0.1.1-rc.1",
      "@deepseek-ai/dsh-native-command": "0.1.1-rc.1",
      "@deepseek-ai/dsh-message-feedback": "0.1.1-rc.1",
      "@deepseek-ai/dsh-permission-presets": "0.1.1-rc.1"
    }
  }
}
